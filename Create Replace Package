CREATE OR REPLACE PACKAGE PKG_MATH AS   
   
   FUNCTION F_SUM(
                    P_NUM1 IN NUMBER, 
                    P_NUM2 IN NUMBER
                ) RETURN NUMBER;
   
END PKG_MATH;
/

CREATE OR REPLACE PACKAGE BODY PKG_MATH AS

   FUNCTION F_SUM(P_NUM1 IN NUMBER, P_NUM2 IN NUMBER) RETURN NUMBER IS
   BEGIN
      RETURN P_NUM1 + P_NUM2;
   END F_SUM;

END PKG_MATH;
/


SELECT PKG_MATH.F_SUM(5,10) FROM DUAL

SET SERVEROUTPUT ON;
BEGIN
    DBMS_OUTPUT.PUT_LINE('Sum = ' || PKG_MATH.F_SUM(10, 20));
END;
