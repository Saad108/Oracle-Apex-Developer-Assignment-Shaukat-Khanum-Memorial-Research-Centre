CREATE OR REPLACE FUNCTION divide (
    p_num1 IN NUMBER,
    p_num2 IN NUMBER
) RETURN NUMBER
IS
BEGIN
    RETURN p_num1 / p_num2;
END;

SELECT divide(20, 10) AS result FROM dual;
*************************************************************
CREATE OR REPLACE PROCEDURE P_DIV(P_NUM1   IN  NUMBER,P_NUM2   IN  NUMBER,
    P_RESULT OUT NUMBER
)
AS
BEGIN
        P_RESULT := P_NUM1 / P_NUM2;
END;
/

DECLARE
    v_result NUMBER;
BEGIN
    P_DIV(50, 10, v_result);
    DBMS_OUTPUT.PUT_LINE('Division Result = ' || v_result);
END;
/
